# Production settings for docker-compose.prod.yml. Copy to .env next to the
# compose file and fill in. Never commit the filled-in copy.
#
# The API refuses to start in production with a placeholder secret, a
# wildcard Host list or a non-HTTPS public URL; the compose file derives
# the last two from NOVA_DOMAIN.

# The public hostname Caddy serves and obtains a certificate for. Its DNS
# must point at this host before the first start, or issuance fails.
NOVA_DOMAIN=nova.example.com

# Image to run. A tag pushed by the release workflow, e.g. v0.1.0. Pin a
# version; "latest" is whatever was built last.
NOVA_API_IMAGE=ghcr.io/hsilviu05/nova-api
NOVA_API_TAG=v0.1.0
NOVA_API_WORKERS=2

# Generate each with:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
NOVA_JWT__SECRET_KEY=
NOVA_DATABASE__PASSWORD=

# Optional. A JSON array; empty is right for a native app.
NOVA_SECURITY__CORS_ORIGINS=[]
NOVA_OBSERVABILITY__LOG_LEVEL=INFO

# AI provider: offline | anthropic | ollama. See .env.example at the repo
# root for what each needs.
NOVA_AI__CHAT_PROVIDER=offline
NOVA_AI__ANTHROPIC_API_KEY=

# Backups: how long to keep nightly dumps, and how often to take them.
NOVA_BACKUP_KEEP_DAYS=14
NOVA_BACKUP_INTERVAL_SECONDS=86400
