# ---------------------------------------------------------------------------
# NOVA environment configuration
#
#   cp .env.example .env
#
# Then generate the JWT secret — it must be unique per environment and must
# never be committed. The `tr` matters: openssl wraps base64 at 64 characters
# and a value split across two lines breaks .env parsing.
#
#   echo "NOVA_JWT__SECRET_KEY=$(openssl rand -base64 48 | tr -d '\n')" >> .env
#
# Settings nest with a double underscore: NOVA_DATABASE__HOST maps to
# Settings.database.host.
# ---------------------------------------------------------------------------

# local | test | staging | production
NOVA_ENVIRONMENT=local
NOVA_DEBUG=false

# --- Ports published on the host -------------------------------------------
NOVA_API_PORT=8000
NOVA_POSTGRES_PORT=5432
NOVA_REDIS_PORT=6379

# --- PostgreSQL ------------------------------------------------------------
# Host is `postgres` inside docker compose, `localhost` when running the API
# on the host against the compose database.
NOVA_DATABASE__HOST=localhost
NOVA_DATABASE__PORT=5432
NOVA_DATABASE__USER=nova
NOVA_DATABASE__PASSWORD=nova_dev_password
NOVA_DATABASE__NAME=nova
NOVA_DATABASE__ECHO=false

# --- Redis -----------------------------------------------------------------
NOVA_REDIS__HOST=localhost
NOVA_REDIS__PORT=6379
NOVA_REDIS__DB=0

# --- Authentication --------------------------------------------------------
# REQUIRED. No default — the API refuses to start without it. Minimum 32
# characters. Generate with the openssl command above.
NOVA_JWT__SECRET_KEY=

NOVA_JWT__ACCESS_TOKEN_TTL_SECONDS=900
NOVA_JWT__REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Security --------------------------------------------------------------
# JSON array. Empty disables CORS entirely, which is correct for a native
# mobile client; add origins only for a browser front-end.
NOVA_SECURITY__CORS_ORIGINS=[]
NOVA_SECURITY__AUTH_RATE_LIMIT_ATTEMPTS=10
NOVA_SECURITY__AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- AI --------------------------------------------------------------------
# offline | anthropic
#
# offline needs no credential and is the default, so the stack starts and the
# tests run without a key. Selecting anthropic without one degrades back to
# offline with a warning rather than refusing to boot.
NOVA_AI__CHAT_PROVIDER=offline
NOVA_AI__CHAT_MODEL=claude-opus-5

# Required only when CHAT_PROVIDER=anthropic. Never commit a real key.
NOVA_AI__ANTHROPIC_API_KEY=

# Replies from a desk companion are a few sentences; a generous cap would
# only pay for a runaway.
NOVA_AI__MAX_REPLY_TOKENS=600
# Turns of history sent with each request. Older context returns through
# semantic memory in Phase 5 rather than by raising this.
NOVA_AI__CONTEXT_WINDOW_MESSAGES=20

# AI calls cost real money, so they are limited more tightly than reads.
NOVA_AI__MESSAGE_RATE_LIMIT=30
NOVA_AI__MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60

# --- Observability ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
NOVA_OBSERVABILITY__LOG_LEVEL=INFO
# false gives colourised console output for local development
NOVA_OBSERVABILITY__LOG_JSON=true
