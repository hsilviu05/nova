# ---------------------------------------------------------------------------
# NOVA environment configuration
#
#   cp .env.example .env
#
# Then generate the JWT secret — it must be unique per environment and must
# never be committed. The `tr` matters: openssl wraps base64 at 64 characters
# and a value split across two lines breaks .env parsing.
#
#   echo "NOVA_JWT__SECRET_KEY=$(openssl rand -base64 48 | tr -d '\n')" >> .env
#
# Settings nest with a double underscore: NOVA_DATABASE__HOST maps to
# Settings.database.host.
# ---------------------------------------------------------------------------

# local | test | staging | production
NOVA_ENVIRONMENT=local
NOVA_DEBUG=false

# --- Ports published on the host -------------------------------------------
NOVA_API_PORT=8000
NOVA_POSTGRES_PORT=5432
NOVA_REDIS_PORT=6379

# --- PostgreSQL ------------------------------------------------------------
# Host is `postgres` inside docker compose, `localhost` when running the API
# on the host against the compose database.
NOVA_DATABASE__HOST=localhost
NOVA_DATABASE__PORT=5432
NOVA_DATABASE__USER=nova
NOVA_DATABASE__PASSWORD=nova_dev_password
NOVA_DATABASE__NAME=nova
NOVA_DATABASE__ECHO=false

# --- Redis -----------------------------------------------------------------
NOVA_REDIS__HOST=localhost
NOVA_REDIS__PORT=6379
NOVA_REDIS__DB=0

# --- Authentication --------------------------------------------------------
# REQUIRED. No default — the API refuses to start without it. Minimum 32
# characters. Generate with the openssl command above.
NOVA_JWT__SECRET_KEY=

NOVA_JWT__ACCESS_TOKEN_TTL_SECONDS=900
NOVA_JWT__REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Security --------------------------------------------------------------
# JSON array. Empty disables CORS entirely, which is correct for a native
# mobile client; add origins only for a browser front-end.
NOVA_SECURITY__CORS_ORIGINS=[]
NOVA_SECURITY__AUTH_RATE_LIMIT_ATTEMPTS=10
NOVA_SECURITY__AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- AI --------------------------------------------------------------------
# ollama | openai_compatible | anthropic | offline
#
# Local first. "ollama" is the intended provider for a NOVA running on your
# own machine. "offline" needs nothing installed and is the default, so the
# stack starts and the tests run with no model at all -- it answers with
# honest canned lines rather than pretending.
#
# Selecting a provider that is not configured degrades back to offline with a
# warning rather than refusing to boot: a terminal that will not start tells
# you nothing, while one that starts and says the model is missing tells you
# exactly what is wrong. /api/v1/system/status reports which you have.
NOVA_AI__CHAT_PROVIDER=offline

# Pick a model whose capabilities include tools -- `ollama show <model>` lists
# them. A model without tool support will describe running a command instead
# of running one.
NOVA_AI__CHAT_MODEL=qwen3.8:latest

# Ollama on this machine. From inside a container this is
# http://host.docker.internal:11434 instead.
NOVA_AI__OLLAMA_BASE_URL=http://127.0.0.1:11434

# Any server speaking the OpenAI chat-completions format: llama.cpp, vLLM,
# LM Studio, or Ollama's own /v1 endpoint. Used when CHAT_PROVIDER is
# openai_compatible. The key is usually unnecessary for a local server.
NOVA_AI__OPENAI_BASE_URL=http://127.0.0.1:11434/v1
NOVA_AI__OPENAI_API_KEY=

# Required only when CHAT_PROVIDER=anthropic. Never commit a real key.
NOVA_AI__ANTHROPIC_API_KEY=

# Terminal answers are longer than a companion's: one often carries a command,
# a short listing, or a stack trace.
NOVA_AI__MAX_REPLY_TOKENS=1500
# Turns of history sent with each request. Older context returns through
# semantic memory rather than by raising this.
NOVA_AI__CONTEXT_WINDOW_MESSAGES=20

# --- Memory ----------------------------------------------------------------
# lexical | hash | openai_compatible
#
# "lexical" measures shared vocabulary, which genuinely retrieves without
# pretending to be semantic. "hash" is content-addressed and carries no
# similarity at all; it exists only for storage-plumbing tests.
# "openai_compatible" reaches a local embedding server.
#
# A chat model and an embedder are rarely the same thing -- see ADR 011.
# Swapping one in needs this setting plus a re-embedding pass over existing
# rows, and only works for a model whose width matches the column below.
NOVA_AI__EMBEDDING_PROVIDER=lexical
NOVA_AI__EMBEDDING_MODEL=nomic-embed-text

# Must match the memories column. Changing it needs a migration AND a
# re-embedding pass: vectors of different widths cannot be compared, so a
# mismatch fails at startup rather than on the first insert.
NOVA_AI__EMBEDDING_DIMENSIONS=1536

# How many memories are retrieved before a reply.
NOVA_AI__MEMORY_RETRIEVAL_LIMIT=6
# Cosine distance above which a memory is too unrelated to include. Recall
# matters more than precision here: an irrelevant memory costs a few tokens,
# a missed one costs the illusion that NOVA remembers anything.
NOVA_AI__MEMORY_MAX_DISTANCE=0.85

# Extraction costs one model call per exchange, so it can be turned off.
NOVA_AI__MEMORY_EXTRACTION_ENABLED=true
# Candidates the extractor was less sure of than this are discarded.
NOVA_AI__MEMORY_MIN_CONFIDENCE=0.4

# Messages cost model time and may run tools, so they are limited more
# tightly than ordinary reads -- and per account rather than per address,
# since the caller is authenticated by then.
NOVA_AI__MESSAGE_RATE_LIMIT=30
NOVA_AI__MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Tools -- what NOVA is allowed to do to this machine
#
# Every default here is the conservative one. Turning a group on is a
# deliberate act by the person who owns the machine. Read the tool system
# section of SECURITY.md before enabling anything below the first block.
#
# These are JSON values. Quote them in a shell, or it will split on spaces:
#   NOVA_TOOLS__WORKSPACE_ROOTS='["/path/with spaces"]'
# ---------------------------------------------------------------------------

# Read-only groups. On by default because none of them can change anything.
NOVA_TOOLS__SYSTEM_ENABLED=true
NOVA_TOOLS__GIT_ENABLED=true
NOVA_TOOLS__PROJECTS_ENABLED=true
NOVA_TOOLS__MEMORY_TOOLS_ENABLED=true

# Off by default: this reaches a daemon that can stop anything on the machine.
NOVA_TOOLS__DOCKER_ENABLED=false

# Off by default, and registers nothing without a token below.
NOVA_TOOLS__GITHUB_ENABLED=false

# Directories the git and disk tools may look at. An empty list means NOTHING
# is reachable, which is the safe reading -- not everything.
NOVA_TOOLS__WORKSPACE_ROOTS=[]

# Arbitrary command execution. Off, and even when on it runs only the programs
# named in the allowlist -- an empty allowlist registers no tool at all.
# A general shell reachable from a chat message is a remote code execution
# vulnerability with a friendly interface.
NOVA_TOOLS__SHELL_ENABLED=false
NOVA_TOOLS__SHELL_ALLOWLIST=[]

# A tool that has not answered in this long is killed, along with its process
# group. Local commands are fast; anything slower is hung.
NOVA_TOOLS__COMMAND_TIMEOUT_SECONDS=15
# Tool output goes into a prompt, so its size is both a cost and a risk.
# Truncation is visible in the result rather than silent.
NOVA_TOOLS__MAX_OUTPUT_BYTES=8000

# How long a confirmation for a destructive action stays valid. Short: it is
# an answer to a question asked seconds ago.
NOVA_TOOLS__CONFIRMATION_TTL_SECONDS=180

# Rounds of tool use inside a single reply. Two is enough for "check
# something, then answer about it"; more is an agent looping, which is out of
# scope. The final round is offered no tools, so the model has to answer.
NOVA_TOOLS__MAX_TOOL_ROUNDS=3

NOVA_TOOLS__TOOL_RATE_LIMIT=60
NOVA_TOOLS__TOOL_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Integrations -- things outside this machine
# ---------------------------------------------------------------------------

# Read-only scopes. NOVA never pushes, merges or comments; being asked about
# the work is a different thing from doing it. The token is unwrapped inside
# one module and never reaches a prompt.
NOVA_INTEGRATIONS__GITHUB_TOKEN=
NOVA_INTEGRATIONS__GITHUB_API_URL=https://api.github.com

# Services NOVA can be asked about by name. The model picks from this list and
# cannot supply a URL of its own -- otherwise a prompt injection could aim
# NOVA's health check at any address reachable from the server.
#
# NOVA_INTEGRATIONS__PROJECTS='[{"name":"SnapWorth","base_url":"http://localhost:9000","health_path":"/health","description":"Valuation API"}]'
NOVA_INTEGRATIONS__PROJECTS=[]

NOVA_INTEGRATIONS__REQUEST_TIMEOUT_SECONDS=8

# --- Observability ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
NOVA_OBSERVABILITY__LOG_LEVEL=INFO
# false gives colourised console output for local development
NOVA_OBSERVABILITY__LOG_JSON=true
