# ---------------------------------------------------------------------------
# SECRETS — never commit credentials, keys, or environment files.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.pfx
secrets.json
credentials.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# Node / Expo (apps/mobile)
# ---------------------------------------------------------------------------
node_modules/
.expo/
.expo-shared/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ML — data and trained artifacts are not source. Model metadata is.
# ---------------------------------------------------------------------------
ml/data/raw/
ml/data/interim/
ml/data/processed/
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.onnx
mlruns/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
# ...except the workspace settings, which are checked in. Without them the
# editor uses the system Python, cannot resolve fastapi, jwt or argon2, and
# reports dozens of errors in code that is fine. That is not a personal
# preference, it is the difference between a clone that opens clean and one
# that looks broken.
#
# `.vscode/*` rather than `.vscode/`: git will not re-include a file whose
# parent directory is excluded, so the negation below only works against a
# pattern that matches the contents rather than the directory itself.
!.vscode/settings.json

# Xcode.
#
# NOVA.xcodeproj IS tracked, which reverses the original decision and is worth
# saying why. project.yml remains the source of truth: the project is
# generated from it by XcodeGen, or by apps/ios/tools/generate_xcodeproj.py
# where there is no Swift toolchain. Tracking the result means the repository
# can be cloned and opened, with no toolchain and no Homebrew, which turned
# out to matter more than the merge conflicts it costs. Regenerate rather than
# resolve a conflict in it -- the generator is deterministic, so the output is
# byte-identical for a given spec.
#
# Everything genuinely per-user stays ignored.
*.xcworkspace
xcuserdata/
DerivedData/
*.xcuserstate
.swiftpm/
